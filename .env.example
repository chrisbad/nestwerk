# Kopieren nach .env und Werte anpassen (nicht einchecken!). install.sh füllt alles automatisch aus.

# Welche Compose-Dateien gelten:
#   hinter dem zentralen nginx-proxy:   compose.prod.yaml:compose.proxy.yaml
#   eigener Reverse Proxy auf 127.0.0.1: compose.prod.yaml
COMPOSE_FILE=compose.prod.yaml:compose.proxy.yaml

# Version des Images von ghcr.io/chrisbad/nestwerk (z. B. 1.2.0); latest = neueste Version
NESTWERK_VERSION=latest

# Installationsverzeichnis auf dem Host (für den Updater-Dienst; install.sh setzt es)
NESTWERK_DIR=/opt/nestwerk

POSTGRES_DB=nestwerk
POSTGRES_USER=nestwerk
POSTGRES_PASSWORD=bitte-aendern

# Initialer Admin, wird nur angelegt, solange keine Benutzer existieren
NESTWERK_ADMIN_USERNAME=admin
NESTWERK_ADMIN_PASSWORD=bitte-aendern

# Schlüssel für gespeicherte Zugangsdaten der Sicherungsziele (z. B. openssl rand -base64 32)
NESTWERK_SECRET_KEY=bitte-aendern

# Domain, unter der Nestwerk erreichbar ist (für nginx-proxy und Let's Encrypt)
NESTWERK_DOMAIN=nestwerk.example.org
LETSENCRYPT_EMAIL=admin@example.org

# Öffentliche Adresse (für Links in Mails und Push; Push braucht HTTPS)
NESTWERK_BASE_URL=https://nestwerk.example.org

# Nur ohne nginx-proxy: Host-Adresse:Port, auf die der eigene Reverse Proxy zeigt
APP_BIND=127.0.0.1:8080

# Optional: Verzeichnis der externen Backup-Platte auf dem Server (z. B. /mnt/usb-backup)
#NESTWERK_EXTERNAL_BACKUP_HOST_DIR=/mnt/usb-backup

# E-Mail-Benachrichtigungen (leer lassen = ohne E-Mail)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=nestwerk@example.org
