<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>club.badernet</groupId>
        <artifactId>nestwerk-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>nestwerk-transfer</artifactId>
    <name>nestwerk-transfer</name>
    <description>Import und Export (iCalendar, vCard, CSV)</description>
    <dependencies>
        <dependency>
            <groupId>club.badernet</groupId>
            <artifactId>nestwerk-core</artifactId>
        </dependency>
        <dependency>
            <groupId>club.badernet</groupId>
            <artifactId>nestwerk-calendar</artifactId>
        </dependency>
        <dependency>
            <groupId>club.badernet</groupId>
            <artifactId>nestwerk-contact</artifactId>
        </dependency>
        <dependency>
            <groupId>club.badernet</groupId>
            <artifactId>nestwerk-todo</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>com.googlecode.ez-vcard</groupId>
            <artifactId>ez-vcard</artifactId>
            <exclusions>
                <!-- nur für hCard/jCard nötig; vCard-Text braucht sie nicht (Freemarker lädt die API aber immer) -->
                <exclusion>
                    <groupId>org.jsoup</groupId>
                    <artifactId>jsoup</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
