<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>club.badernet</groupId>
    <artifactId>nestwerk-parent</artifactId>
    <!-- beim Release setzt die CI die Version aus dem Git-Tag: -Drevision=1.2.0 -->
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>nestwerk</name>
    <description>nestwerk</description>
    <properties>
        <java.version>25</java.version>
        <revision>0.0.1-SNAPSHOT</revision>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- spring-boot:run läuft nur im Modul nestwerk-app (dort wieder eingeschaltet) -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <!-- Abhängigkeitsrichtung: core <- calendar <- notification <- ... <- web <- ai <- app -->
    <modules>
        <module>nestwerk-core</module>
        <module>nestwerk-calendar</module>
        <module>nestwerk-notification</module>
        <module>nestwerk-contact</module>
        <module>nestwerk-todo</module>
        <module>nestwerk-household</module>
        <module>nestwerk-kitchen</module>
        <module>nestwerk-attachment</module>
        <module>nestwerk-transfer</module>
        <module>nestwerk-maintenance</module>
        <module>nestwerk-web</module>
        <module>nestwerk-ai</module>
        <module>nestwerk-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-calendar</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-contact</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-todo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-household</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-kitchen</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-attachment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-transfer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-maintenance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>club.badernet</groupId>
                <artifactId>nestwerk-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mnode.ical4j</groupId>
                <artifactId>ical4j</artifactId>
                <version>4.4.0</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.ez-vcard</groupId>
                <artifactId>ez-vcard</artifactId>
                <version>0.12.2</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>1.14.1</version>
            </dependency>
            <dependency>
                <groupId>com.github.mwiede</groupId>
                <artifactId>jsch</artifactId>
                <version>2.28.8</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>0.24.0</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
                <artifactId>owasp-java-html-sanitizer</artifactId>
                <version>20240325.1</version>
            </dependency>
            <dependency>
                <groupId>com.icegreen</groupId>
                <artifactId>greenmail-junit5</artifactId>
                <version>2.1.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
